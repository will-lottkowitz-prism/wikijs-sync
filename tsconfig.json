{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "ignoreDeprecations": "5.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "target": "ES2021",
    "lib": ["ES2021"],
    "rootDir": "src",
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
